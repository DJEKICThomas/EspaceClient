<bean id="sessionFactory" class="org.springframework.orm.hibernate5.LocalSessionFactoryBean">
    <property name="packagesToScan">
        <list>
            <value>be.depairon.espaceclient.entity</value>
        </list>
    </property>
    <property name="hibernateProperties">
        <props>
            <prop key="hibernate.dialect">org.hibernate.dialect.DB2Dialect</prop>
            <prop key="hibernate.connection.driver_class">com.ibm.as400.access.AS400JDBCDriver</prop>
            <prop key="hibernate.connection.url">${db.url}</prop>
            <prop key="hibernate.connection.username">${db.username}</prop>
            <prop key="hibernate.connection.password">${db.password}</prop>
            <prop key="hibernate.default_schema">YGCOMMON</prop>
        </props>
    </property>
    <property name="dataSource">
        <ref bean="dataSource" />
    </property>
</bean>